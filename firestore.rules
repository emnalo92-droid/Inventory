rules_version = '2';

/**
 * ============================================================================
 * FIRESTORE OPTIMIZATION & USAGE RULES
 * ============================================================================
 * 1. Use limit() and cursor pagination (startAfter) on every query. Never fetch a whole collection.
 * 2. Use getDoc/getDocs for data that rarely changes. Only use onSnapshot where live updates are truly needed, and unsubscribe when the component unmounts.
 * 3. Combine multiple field changes into a single updateDoc call.
 * 4. Debounce user input (e.g. typing, sliders, autosave) so it writes at most once every few seconds, not on every keystroke.
 * 5. Skip writes when the value hasn't changed.
 * 6. Cache results on the client (memory or local storage) and avoid refetching on every page load or re-render.
 * 7. Enable Firestore offline persistence so repeat reads hit the local cache.
 * 8. Store data that is read together in one document instead of splitting it across many.
 * 9. Use counters or aggregates (count() queries, or a stored summary field) instead of reading every document to count or total them.
 * 10. Don't read a document right after writing it. Update the UI from local state.
 * ============================================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'em.nalo92@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidInventoryData(data) {
      return data.keys().hasAll(['inv', 'start', 'cut']) &&
             data.keys().hasOnly([
               'v', 'locs', 'inv', 'start', 'cut', 'items', 'rows',
               'cash', 'cinfo', 'cashiers', 'cpay', 'users', 'log',
               'vd', 'vf', 'nc', 'notes', 'updatedAt', 'updatedBy'
             ]) &&
             data.inv is string && data.inv.size() >= 1 && data.inv.size() <= 150 &&
             data.start is string && data.start.size() >= 1 && data.start.size() <= 32 &&
             data.cut is string && data.cut.size() >= 1 && data.cut.size() <= 32 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['t', 'u', 'act', 'desc']) &&
             data.keys().hasOnly(['id', 't', 'u', 'tab', 'act', 'desc', 'date', 'loc']) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.t is string && data.t.size() >= 1 && data.t.size() <= 64 &&
             data.u is string && data.u.size() >= 1 && data.u.size() <= 100 &&
             (!('tab' in data) || (data.tab is string && data.tab.size() <= 50)) &&
             data.act is string && data.act.size() >= 1 && data.act.size() <= 50 &&
             data.desc is string && data.desc.size() <= 500 &&
             (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
             (!('loc' in data) || (data.loc is string && data.loc.size() <= 150));
    }

    // Admin registry (managed server-side / Firebase Console only)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if false;
      allow write: if false;
    }

    // Connection testing doc (verified signed-in users only)
    match /test/{testId} {
      allow get: if isValidId(testId) && testId == 'connection' && isVerifiedUser();
      allow list: if false;
      allow write: if isAdmin();
    }

    // Main inventory state (Admin Firebase users only; staff terminals sync via authenticated Express/Cloud SQL API)
    match /inventory_data/{docId} {
      allow get: if isValidId(docId) && isAdmin();
      allow list: if false;
      allow create: if isValidId(docId) && isAdmin() && isValidInventoryData(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidInventoryData(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'v', 'locs', 'inv', 'start', 'cut', 'items', 'rows',
                         'cash', 'cinfo', 'cashiers', 'cpay', 'users', 'log',
                         'vd', 'vf', 'nc', 'notes', 'updatedAt', 'updatedBy'
                       ]);
      allow delete: if isValidId(docId) && isAdmin();
    }

    // Audit logs (Admin Firebase users only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming());
      allow update: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'id', 't', 'u', 'tab', 'act', 'desc', 'date', 'loc'
                       ]);
      allow delete: if isValidId(logId) && isAdmin();
    }

    // Live presence is handled exclusively via authenticated server API (/api/presence)
    match /presence/{userId} {
      allow read, write: if false;
    }
  }
}
